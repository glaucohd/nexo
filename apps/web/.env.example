# Use a URL do Session Pooler exibida em Supabase > Connect.
DATABASE_URL=postgresql://postgres.PROJECT-REF:YOUR-PASSWORD@POOLER-HOST:5432/postgres
BETTER_AUTH_SECRET=troque-por-uma-chave-com-pelo-menos-32-caracteres
BETTER_AUTH_URL=http://localhost:3000

# O Nexo ainda não usa o cliente Supabase no navegador. Reserve estas variáveis
# para quando Storage, Realtime ou a Data API forem habilitados.
NEXT_PUBLIC_SUPABASE_URL=https://PROJECT-REF.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_EXEMPLO
